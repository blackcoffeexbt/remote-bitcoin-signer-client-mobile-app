{
  "expo": {
    "name": "Argus",
    "slug": "argus",
    "version": "0.5.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lnbits.remotebitcoinsigner",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your Electrs server on your local network to sync and broadcast Testnet4 payments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006C67",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lnbits.remotebitcoinsigner",
      "allowBackup": false,
      "versionCode": 9
    },
    "scheme": "remote-bitcoin-signer",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "./plugins/withDeviceScheme",
      "./plugins/withActivityLintWorkaround",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing code on your signing device.",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F8F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#0E1C22",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ]
    ]
  }
}
